diff --git a/css/charte.css b/css/charte.css
index 484bdd2..60022df 100644
--- a/css/charte.css
+++ b/css/charte.css
@@ -156,3 +156,26 @@ ol,ul{list-style:none}
   .toast{left:var(--marge)}
 }
 @media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
+
+/* ——— Vert M7 GOAT (couleur des flacons) ——— */
+:root{/* deux couleurs, deux rôles : le vert pour acheter (boutons, prix, étiquettes, bande des combos), le marron pour la marque (titres, chiffres, pied de page) */--vert:#1d3b2b;--vert-nuit:#132a1e;--vert-pale:#eef2ec;--vert-filet:#c9d6cb;--or:#c59b4e;--creme:#f3eee6}
+:focus-visible{outline-color:var(--vert)}
+.bouton{background:var(--vert)}
+.bouton:hover{background:var(--encre)}
+.bouton.creux{background:transparent;color:var(--vert);box-shadow:inset 0 0 0 1px var(--vert)}
+.bouton.creux:hover{background:var(--vert);color:#fff}
+.pastille{background:var(--vert)}
+.tuile .n .prix{color:var(--vert);font-weight:500}
+.tuile .ajout:hover{background:var(--vert)}
+.etiquette{background:var(--vert);color:var(--creme)}
+.toast{background:var(--vert)}
+.ok{color:var(--or)}
+/* pied de page marron : le vert sert à acheter, le marron porte la marque */
+.pied{background:var(--encre);color:var(--creme)}
+.pied .news .lab,.pied .cols span,.pied .mini{color:rgba(243,238,230,.55)}
+.pied .ch{border-bottom-color:rgba(243,238,230,.5)}
+.pied .ch input::placeholder{color:rgba(243,238,230,.5)}
+.pied .geant{color:var(--creme)}
+.pied .geant::first-letter{color:var(--or)}
+/* une ligne de titre découpée reste une ligne, avec ou sans animation */
+.r-ligne .l{display:block}
diff --git a/css/pages.css b/css/pages.css
index daca03b..fc13e44 100644
--- a/css/pages.css
+++ b/css/pages.css
@@ -323,3 +323,33 @@
 /* la boutique compte cinq pièces : cinq colonnes sur grand écran, la dernière s'étale sur deux colonnes ailleurs */
 @media (min-width:1101px){.grille-boutique .rang{grid-template-columns:repeat(5,1fr)}}
 @media (max-width:1100px){.grille-boutique .tuile:last-child:nth-child(odd){grid-column:span 2}.grille-boutique .tuile:last-child:nth-child(odd) .v{aspect-ratio:3/2}}
+
+/* ——— Vert M7 GOAT ——— */
+.onglet[aria-pressed="true"]{color:var(--vert);box-shadow:inset 0 -1px 0 var(--vert)}
+.infos .prix-grand{color:var(--vert);font-weight:400}
+.pieces{display:grid;gap:12px}
+.pieces li{display:grid;gap:2px;padding-left:16px;position:relative}
+.pieces li::before{content:"";position:absolute;left:0;top:.6em;width:6px;height:6px;border-radius:50%;background:var(--vert)}
+.pieces b{font-weight:500}
+.pieces span{color:var(--doux);font-size:14px}
+
+/* bande « Les combos » : vert des flacons, filets or */
+.combos{background:var(--vert);color:var(--creme);display:grid;grid-template-columns:1fr 1fr;min-height:min(92svh,820px)}
+.combos-tx{padding:var(--section) var(--marge);display:flex;flex-direction:column;justify-content:space-between;gap:48px}
+.combos .lab{color:var(--or)}
+.combos h2{font-size:var(--t-h2);margin-top:22px}
+.combos-tx>div>p{max-width:430px;margin-top:22px;color:rgba(243,238,230,.75)}
+.paliers{display:grid;border-top:1px solid rgba(197,155,78,.45)}
+.paliers a{display:flex;justify-content:space-between;align-items:baseline;gap:16px;padding:16px 0;border-bottom:1px solid rgba(197,155,78,.45);font-size:12px;letter-spacing:.1em;text-transform:uppercase;transition:padding .4s var(--courbe),color .3s}
+.paliers a:hover{padding-left:10px;color:var(--or)}
+.paliers .prix{font-size:clamp(20px,2vw,28px);font-weight:200;letter-spacing:0;text-transform:none;color:var(--or)}
+.paliers small{font-size:11px;letter-spacing:.1em;color:rgba(243,238,230,.55);margin-right:8px}
+.combos .bouton{align-self:flex-start;background:var(--or);color:var(--vert-nuit)}
+.combos .bouton:hover{background:var(--creme)}
+.combos-img{position:relative;overflow:hidden;margin:0}
+.combos-img img{width:100%;height:100%;object-fit:cover;object-position:50% 60%}
+.combos-img figcaption{position:absolute;left:var(--marge);bottom:24px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#fff}
+@media (max-width:900px){
+  .combos{grid-template-columns:1fr}
+  .combos-img{order:-1;height:70svh}
+}
